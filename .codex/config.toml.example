# Скопировать нужные строки в ~/.codex/config.toml или локальный профиль Codex.
# Модель не фиксируется в репозитории: доступные имена меняются чаще, чем игровой scope.

model_reasoning_effort = "medium"
plan_mode_reasoning_effort = "high"
model_verbosity = "low"

# Корневой и вложенные AGENTS.md должны помещаться в стандартный бюджет.
project_doc_max_bytes = 32768
project_doc_fallback_filenames = ["TEAM_GUIDE.md"]
