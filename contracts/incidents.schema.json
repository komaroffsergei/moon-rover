{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moon-courier.local/incidents.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rules",
    "profiles"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dustStormGameMinutes",
        "selfRepairGameMinutes"
      ],
      "properties": {
        "dustStormGameMinutes": {
          "const": 10
        },
        "selfRepairGameMinutes": {
          "const": 10
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "const": "normal"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cellChance",
          "weights"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "cellChance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "weights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dustStorm",
              "meteorite",
              "crater"
            ],
            "properties": {
              "dustStorm": {
                "type": "number",
                "minimum": 0
              },
              "meteorite": {
                "type": "number",
                "minimum": 0
              },
              "crater": {
                "type": "number",
                "minimum": 0
              }
            },
            "anyOf": [
              {
                "properties": {
                  "dustStorm": {
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "properties": {
                  "meteorite": {
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "properties": {
                  "crater": {
                    "exclusiveMinimum": 0
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
