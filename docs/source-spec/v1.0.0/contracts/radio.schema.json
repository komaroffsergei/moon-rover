{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moon-courier.local/radio.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "messages": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        }
      }
    }
  }
}
